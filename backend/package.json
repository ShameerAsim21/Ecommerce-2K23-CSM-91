{
  "name": "root-and-sprout-backend",
  "version": "0.2.0",
  "description": "Root & Sprout - catalog data foundation (Sprint 2)",
  "private": true,
  "main": "src/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node db/migrate.js up",
    "db:reset": "node db/migrate.js reset",
    "seed": "node db/seeds/seed.js",
    "db:fresh": "npm run db:reset && npm run migrate && npm run seed",
    "demo": "node scripts/demo.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
